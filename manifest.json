{
  "manifest_version": 3,
  "name": "nudgememaybe",
  "version": "0.4.0",
  "description": "Gentle one-off nudges in Chrome: pick a time, label it, use presets, get notified. Saved on your device - no account needed.",
  "permissions": ["alarms", "storage", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "nudgememaybe",
    "default_icon": {
      "16": "icons/icon@16px.png",
      "48": "icons/icon@48px.png",
      "128": "icons/icon@128px.png",
      "512": "icons/icon@512px.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon@16px.png",
    "48": "icons/icon@48px.png",
    "128": "icons/icon@128px.png",
    "512": "icons/icon@512px.png"
  }
}
