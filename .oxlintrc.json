{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": "error",
  },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        "no-empty-pattern": "off"
      }
    }
  ],
  "options": {
    "typeAware": true,
  }
}
