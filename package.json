{
  "name": "alarm-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "zip:dist": "bun run scripts/zip-dist.ts",
    "pack": "bun run build && bun run zip:dist",
    "watch": "bun run scripts/build.ts --watch",
    "test": "bun test",
    "playwright:install": "bunx playwright install --with-deps chromium",
    "test:e2e": "bun run build && bunx playwright test",
    "test:e2e:ui": "bun run build && bunx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.11",
    "@types/chrome": "^0.0.280"
  }
}
