{
  "name": "local-alarms",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "zip:dist": "bun run scripts/zip-dist.ts",
    "pack": "rm -rf dist && bun run build && bun run zip:dist",
    "watch": "bun run scripts/build.ts --watch",
    "test": "bun test",
    "playwright:install": "bunx playwright install --with-deps chromium",
    "test:e2e": "bun run build && bunx playwright test",
    "test:e2e:ui": "bun run build && bunx playwright test --ui",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.11",
    "@types/chrome": "^0.0.280",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0"
  }
}
